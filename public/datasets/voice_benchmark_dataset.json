{
  "benchmarkVersion": "2.0.0",
  "name": "SIH_PS2_Layered_Vernacular_Voice_Benchmark",
  "description": "Layered evaluation dataset for vernacular low-literacy informal scrap voice agents",
  "splits": {
    "train_dev": 250,
    "validation": 70,
    "blind_test": 35
  },
  "cases": [
    {
      "caseId": "COMP-001",
      "split": "blind_test",
      "source": {
        "type": "FIELD_RECORDED",
        "region": "Dharavi, Mumbai",
        "language": "hi",
        "acousticCondition": "YARD_HEAVY_NOISE_88DB"
      },
      "context": {
        "screen": "MARKETPLACE",
        "activeLotDraft": { "materialId": "pcb", "reportedWeightKg": 10.0 },
        "visibleOffers": [
          { "buyerName": "Apex Recyclers", "netPayout": 3500, "distanceKm": 14 },
          { "buyerName": "GreenTech E-Waste", "netPayout": 3750, "distanceKm": 8 }
        ]
      },
      "input": {
        "rawTranscript": "अरे वो दूसरा वाला नहीं... पहले वजन पौने बारह किलो कर, फिर जो सबसे ज्यादा रोकड़ हाथ में दे वो लगा."
      },
      "goldNormalization": {
        "tokens": [
          { "word": "अरे", "role": "ATTENTION_FILLER" },
          { "word": "वो दूसरा वाला", "role": "DEICTIC_REFERENCE", "referentIndex": 1 },
          { "word": "नहीं", "role": "REPAIR_REJECTION_MARKER" },
          { "word": "पौने बारह किलो", "role": "FRACTIONAL_QUANTITY", "numericValue": 11.75, "unit": "kg" }
        ],
        "repairs": [
          { "field": "weightKg", "from": 10.0, "to": 11.75 }
        ]
      },
      "goldSemanticFrame": {
        "intent": "COMPOUND_MUTATE_AND_SELECT",
        "entities": {
          "weight": { "value": 11.75, "unit": "kg", "approximate": false },
          "paymentMode": "SPOT_CASH",
          "sortBy": "MAX_NET_PAYOUT"
        },
        "targetIndex": 1
      },
      "expectedCommand": {
        "type": "UPDATE_WEIGHT",
        "payload": { "weightKg": 11.75 }
      },
      "expectedPolicy": {
        "decision": "ALLOW",
        "confirmationType": "PHYSICAL_TAP"
      }
    },
    {
      "caseId": "COMP-002",
      "split": "validation",
      "source": {
        "type": "ACOUSTIC_SIMULATED",
        "region": "Kurla, Mumbai",
        "language": "mr",
        "acousticCondition": "ANGLE_GRINDER_BURST"
      },
      "context": {
        "screen": "SCANNER",
        "activeLotDraft": null
      },
      "input": {
        "rawTranscript": "ऐक ना भाऊ, तांब्याची वाइंडिंग आहे... नाही नाही कॉपर नाही, पितळ आहे सव्वा दोन किलो... भाव काय मिळेल?"
      },
      "goldNormalization": {
        "repairs": [
          { "field": "material", "from": "copper", "to": "brass", "marker": "नाही नाही" }
        ]
      },
      "goldSemanticFrame": {
        "intent": "CREATE_DRAFT_AND_QUERY_RATES",
        "entities": {
          "material": { "surface": "पितळ", "probableStream": "cables", "confidence": "HIGH" },
          "weight": { "value": 2.25, "unit": "kg", "approximate": false }
        }
      },
      "expectedCommand": {
        "type": "CREATE_LOT_DRAFT",
        "payload": { "materialId": "cables", "reportedWeightKg": 2.25 }
      },
      "expectedPolicy": {
        "decision": "ALLOW",
        "confirmationType": "NONE"
      }
    },
    {
      "caseId": "COMP-003",
      "split": "blind_test",
      "source": {
        "type": "FIELD_RECORDED",
        "region": "Seelampur, Delhi",
        "language": "hi",
        "acousticCondition": "DIESEL_IDLING_75DB"
      },
      "context": {
        "screen": "MARKETPLACE",
        "selectedOffer": { "offerId": "OFFER_APEX", "netPayout": 108500, "buyerName": "Apex Recyclers" }
      },
      "input": {
        "rawTranscript": "हां सब मंजूर है, एक लाख आठ हजार पांच सौ का सौदा फाइनल करो अभी!"
      },
      "goldSemanticFrame": {
        "intent": "REQUEST_ACCEPT_OFFER",
        "entities": {
          "amount": 108500,
          "currency": "INR"
        }
      },
      "expectedPolicy": {
        "decision": "ALLOW",
        "confirmationType": "PHYSICAL_HOLD_5S",
        "durationMs": 5000,
        "reason": "HIGH_VALUE_TRANSACTION_SAFETY_GATE"
      }
    },
    {
      "caseId": "NEG-001",
      "split": "validation",
      "source": {
        "type": "SYNTHETIC_AUGMENTED",
        "language": "hi"
      },
      "context": {
        "screen": "HOME",
