    {
      "caseId": "NEG-002",
      "split": "blind_test",
      "source": {
        "type": "SYNTHETIC_AUGMENTED",
        "language": "hi"
      },
      "context": {
        "screen": "MARKETPLACE",
        "visibleOffers": [
          { "buyerName": "Apex", "netPayout": 2400 },
          { "buyerName": "GreenTech", "netPayout": 2400 }
        ]
      },
      "input": {
        "rawTranscript": "जो सही लगे वो चुन लो."
      },
