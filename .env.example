# ==============================================================================
# E-Waste Bridge - Environment Configuration
# SIH 2026 Problem Statement 2
# ==============================================================================

# Application Environment (development, staging, production)
NODE_ENV=production

# Base URL / API Gateway (leave empty or "/" for standalone offline PWA mode)
VITE_API_URL=

# Default Vernacular Language ('hi' for Hindi, 'mr' for Marathi, 'en' for English)
VITE_DEFAULT_LANGUAGE=hi

# Application Display Name & Branding
VITE_APP_NAME="E-Waste Bridge"

# Fallback Offline Telemetry Sync Rate (ms)
VITE_TELEMETRY_SYNC_INTERVAL_MS=30000

# High-Value Hold Authorization Threshold (INR)
VITE_HIGH_VALUE_THRESHOLD_INR=100000

# High-Value Physical Hold Gate Duration (ms)
VITE_HOLD_GATE_DURATION_MS=5000
